{
  module: "MMM-LeanRSS",
  position: "bottom_bar",
  config: {
    feeds: [
      { url: "https://feeds.bbci.co.uk/news/rss.xml",          label: "BBC",      color: "#ff6b6b" },
      { url: "https://feeds.skynews.com/feeds/rss/home.xml",   label: "Sky",      color: "#4fc3f7" },
      { url: "https://feeds.bbci.co.uk/news/technology/rss.xml", label: "Tech",    color: "#a5d6a7" },
    ],
    display: {
      maxItems:     20,
      scrollSpeed:  60,
      pauseOnHover: true,
      showSource:   true,
      showAge:      false,
      scale:        1.0,
      compact:      false,
      direction:    "ptf",
    },
    polling: {
      updateInterval: 300000,
      fetchTimeout:   8000,
      maxAgeHours:    24,
    },
  }
}
